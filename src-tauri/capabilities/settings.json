{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Lets the settings window read, write, export and import settings, install, remove and manage external plugins, look for and install updates, show the Discord status as a preview, list and install plugins from the public plugin list, open the log and set its own title.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-settings",
    "allow-update-settings",
    "allow-update-plugin-settings",
    "allow-list-external-plugins",
    "allow-open-plugins-folder",
    "allow-reload-plugins",
    "allow-restart-required",
    "allow-restart-app",
    "allow-open-log",
    "allow-export-settings",
    "allow-import-settings",
    "allow-get-health",
    "allow-is-first-run",
    "allow-install-plugin",
    "allow-remove-plugin",
    "allow-app-version",
    "allow-pending-update",
    "allow-check-update",
    "allow-install-update",
    "allow-discord-preview",
    "allow-marketplace-list",
    "allow-marketplace-install",
    "allow-marketplace-open-homepage",
    "core:window:allow-set-title"
  ]
}
