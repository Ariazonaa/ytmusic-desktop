{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music Desktop",
  "version": "../package.json",
  "identifier": "io.github.ariazonaa.ytmusic-desktop",
  "build": {
    "beforeDevCommand": "npm run dev:watch",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNEE2NDkyOTEyQzBFREEKUldUYURpeVJrbVJLd1JQbnhxQk13dW1BS1JEd2hSN3BMVTA2aEJhQlhETjEzVkUydkpUMmlFT0MK",
      "endpoints": ["https://github.com/Ariazonaa/ytmusic-desktop/releases/latest/download/latest.json"]
    }
  }
}
